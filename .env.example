# Adzuna (https://developer.adzuna.com) — placeholders only. Copy to .env and fill in.
# Never commit a real app_id / app_key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated lists fan out: each role × each region is one Adzuna/Jooble
# request. Pair countries with cities by index when the counts match.
# Greenhouse fetches each board once and keeps titles matching any role phrase.
ADZUNA_COUNTRY=us
ADZUNA_WHAT=software engineer
ADZUNA_WHERE=
# Example — multiple roles and regions:
# ADZUNA_WHAT=DevOps Lead,DevOps Architect,DevSecOps Lead
# ADZUNA_COUNTRY=in,nl,us
# ADZUNA_WHERE=Pune,Amsterdam,

# Week 3: Jooble is regional — a jooble.org key is US-only; NL needs nl.jooble.org.
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://jooble.org
API_ADDR=:8080

# Local compose (docker-compose.yml). These are the defaults if unset.
POSTGRES_USER=jobsonar
POSTGRES_PASSWORD=jobsonar
POSTGRES_DB=jobsonar
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://jobsonar:jobsonar@localhost:5432/jobsonar?sslmode=disable

ELASTICMQ_PORT=9324
OLLAMA_PORT=11434
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# ollama (default) or fake (deterministic 768-d vectors; no model pull)
EMBED_BACKEND=ollama
# Truncate JDs before nomic; larger batches cut Ollama/Postgres round-trips.
EMBED_TEXT_CHARS=2000
EMBED_BATCH=32
SCORE_BATCH=128
RESUME_DIR=./data/resumes
TAILOR_DIR=./data/tailor

# Week 7: deep dive on scores.band=strong only. fake = no network (default for
# tests / corp TLS). ollama needs a chat model (not nomic-embed-text).
# bedrock requires DEEP_DIVE_OPT_IN=1 — fail closed otherwise (NFR-1 / PII).
LLM_MODEL=llama3.2
DEEP_DIVE_BACKEND=fake
DEEP_DIVE_OPT_IN=0
SHORTLIST_BAND=strong
# BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Optional official web search for company+role review snippets.
# Glassdoor and Mouthshut have no public read API — without this key the
# UI still shows outbound search links (no scraping).
BRAVE_SEARCH_API_KEY=

# Tailor tab (FR-25) always uses the local LLM (ollama or fake) — never Bedrock.
# Resume text is read from disk by the agent and is not logged.

# Week 8: named multi-profile support (amol, nitiraj). Used by the Go API
# when a request omits ?profile=<name> (falls back to the first profile
# alphabetically if this is unset too).
DEFAULT_PROFILE_NAME=nitiraj

# Week 8: personalized web search, per profile. Off by default (fail
# closed) -- new source type + new premium spend outside this project's
# defaults, deliberately opt-in. Shells out to the already-authenticated
# Claude Code CLI rather than a new Anthropic/Bedrock API key; revisit
# once this moves to a cloud deployment. Real numbers observed while
# building this: a trivial call is ~$0.07-0.19 (mostly Claude Code's own
# system-prompt cache); one full 8-result search for one profile took
# 423s and found 7 real jobs -- --output-format json buffers everything
# until the whole multi-step search+verify finishes, so budget minutes,
# not seconds, per profile per run.
PERSONALIZED_SEARCH_OPT_IN=0
PERSONALIZED_SEARCH_INTERVAL_HOURS=24
PERSONALIZED_SEARCH_MAX_RESULTS=8
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_SECONDS=600

# Week 2: queue (ElasticMQ locally, real SQS in cloud — see docker-compose.yml
# and elasticmq.conf for the declared "raw-jobs" queue + "raw-jobs-dlq").
# ElasticMQ does not check the access key/secret, but the AWS SDK still needs
# non-empty values to sign requests, so any placeholder works locally.
SQS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/raw-jobs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
